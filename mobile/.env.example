# Copier ce fichier en .env.local et renseigner les valeurs du projet Supabase
# (Supabase > Project Settings > API).
EXPO_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=votre-cle-publique-anon

# Numéro WhatsApp TerraLink au format international, sans "+" ni espaces.
EXPO_PUBLIC_TERRALINK_WHATSAPP=221770000000
EXPO_PUBLIC_TERRALINK_EMAIL=contact@terralink.sn

# Adresse de la version web : les liens de confirmation et de mot de passe oublié y mènent.
EXPO_PUBLIC_WEB_URL=https://terralink-tau.vercel.app
